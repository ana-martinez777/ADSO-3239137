# Only needed to run the seeder outside Docker (npm run seed).
# With Docker, infra/docker-compose.yml passes these values.
API_URL=http://localhost:8000/api/v1
# An API instance whose clock runs 3 days behind, used to register overdue loans.
API_PAST_URL=http://localhost:8001/api/v1
SPORTS_GEAR_ADMIN_USERNAME=admin
SPORTS_GEAR_ADMIN_PASSWORD=change-me
SEED_COACH_PASSWORD=change-me
