# Copy this file to infra/.env and replace every "change-me" value.
# infra/.env holds secrets and must never be committed.

# Database (MySQL 8.4)
DB_DATABASE=sports_gear
DB_USERNAME=sports_gear
DB_PASSWORD=1234567890
DB_ROOT_PASSWORD=1234567890

# API
# Generate a key with: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# If left empty, the container creates a temporary key on every start.
APP_KEY=
# At least 32 random characters, e.g.: php -r "echo bin2hex(random_bytes(32)).PHP_EOL;"
JWT_SECRET=change-me

# Initial administrator created on the first start
SPORTS_GEAR_ADMIN_USERNAME=admin
SPORTS_GEAR_ADMIN_PASSWORD=1234

# Host ports
API_PORT=8000
APP_PORT=8080
PAGE_PORT=8081
